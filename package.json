{
  "name": "synk",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "description": "Synk - modern availability polling and meeting scheduling",
  "scripts": {
    "synk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/calendra.ps1",
    "calendra": "pnpm run synk",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "prisma:generate": "pnpm --filter api exec prisma generate",
    "prisma:migrate": "pnpm --filter api exec prisma migrate dev",
    "prisma:studio": "pnpm --filter api exec prisma studio",
    "lint": "pnpm --filter web lint && pnpm --filter api lint",
    "performance:load": "node scripts/load-meeting.mjs",
    "security:audit": "node scripts/security-audit.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}

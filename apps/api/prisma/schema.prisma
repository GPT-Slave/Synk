generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  meetings      Meeting[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Meeting {
  id               String        @id @default(cuid())
  organizerId      String        @map("organizer_id")
  organizer        User          @relation(fields: [organizerId], references: [id])
  title            String
  description      String?
  slug             String        @unique
  timezone         String
  startDate        DateTime      @map("start_date")
  endDate          DateTime      @map("end_date")
  workdayStart     String        @map("workday_start")
  workdayEnd       String        @map("workday_end")
  slotIntervalMinutes Int        @default(60) @map("slot_interval_minutes")
  finalized        Boolean       @default(false)
  finalSlotAt      DateTime?     @map("final_slot_at")
  responseDeadline DateTime?     @map("response_deadline")
  createdAt        DateTime      @default(now()) @map("created_at")
  participants     Participant[]

  @@index([organizerId])
  @@map("meetings")
}

model Participant {
  id                    String         @id @default(cuid())
  meetingId             String         @map("meeting_id")
  meeting               Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  displayName           String         @map("display_name")
  displayNameNormalized String         @map("display_name_normalized")
  sessionTokenHash      String         @unique @map("session_token_hash")
  comment               String?
  respondedAt           DateTime?      @map("responded_at")
  joinedAt              DateTime       @default(now()) @map("joined_at")
  availabilities        Availability[]

  @@unique([meetingId, displayNameNormalized], map: "uniq_meeting_display_name_normalized")
  @@index([meetingId])
  @@map("participants")
}

model Availability {
  id            String      @id @default(cuid())
  participantId String      @map("participant_id")
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  datetimeStart DateTime    @map("datetime_start")
  datetimeEnd   DateTime    @map("datetime_end")

  @@unique([participantId, datetimeStart, datetimeEnd], map: "uniq_participant_availability_slot")
  @@index([participantId])
  @@map("availabilities")
}

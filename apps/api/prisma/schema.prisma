generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String         @map("password_hash")
  createdAt          DateTime       @default(now()) @map("created_at")
  meetings           Meeting[]
  refreshTokens      RefreshToken[]
  organizerResponses Participant[]  @relation("OrganizerResponses")

  @@map("users")
}

model RefreshToken {
  id        String   @id
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Meeting {
  id                     String        @id @default(cuid())
  organizerId            String        @map("organizer_id")
  organizer              User          @relation(fields: [organizerId], references: [id])
  title                  String
  description            String?
  slug                   String        @unique
  timezone               String
  startDate              DateTime      @map("start_date")
  endDate                DateTime      @map("end_date")
  workdayStart           String        @map("workday_start")
  workdayEnd             String        @map("workday_end")
  slotIntervalMinutes    Int           @default(15) @map("slot_interval_minutes")
  meetingDurationMinutes Int           @default(60) @map("meeting_duration_minutes")
  finalized              Boolean       @default(false)
  locked                 Boolean       @default(false)
  finalSlotAt            DateTime?     @map("final_slot_at")
  finalSlotEnd           DateTime?     @map("final_slot_end")
  createdAt              DateTime      @default(now()) @map("created_at")
  participants           Participant[]

  @@index([organizerId])
  @@index([organizerId, createdAt, id])
  @@map("meetings")
}

model Participant {
  id                    String         @id @default(cuid())
  meetingId             String         @map("meeting_id")
  meeting               Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  displayName           String         @map("display_name")
  displayNameNormalized String         @map("display_name_normalized")
  sessionTokenHash      String?        @unique @map("session_token_hash")
  organizerId           String?        @map("organizer_id")
  organizer             User?          @relation("OrganizerResponses", fields: [organizerId], references: [id], onDelete: Cascade)
  comment               String?
  respondedAt           DateTime?      @map("responded_at")
  joinedAt              DateTime       @default(now()) @map("joined_at")
  availabilities        Availability[]
  sessions              ParticipantSession[]

  @@unique([meetingId, displayNameNormalized], map: "uniq_meeting_display_name_normalized")
  @@unique([meetingId, organizerId], map: "uniq_meeting_organizer_response")
  @@index([meetingId])
  @@index([meetingId, joinedAt])
  @@index([meetingId, respondedAt])
  @@map("participants")
}

model ParticipantSession {
  id            String      @id @default(cuid())
  participantId String      @map("participant_id")
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique @map("token_hash")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([participantId])
  @@map("participant_sessions")
}

model Availability {
  id            String      @id @default(cuid())
  participantId String      @map("participant_id")
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  datetimeStart DateTime    @map("datetime_start")
  datetimeEnd   DateTime    @map("datetime_end")

  @@unique([participantId, datetimeStart, datetimeEnd], map: "uniq_participant_availability_slot")
  @@index([participantId])
  @@index([participantId, datetimeStart])
  @@map("availabilities")
}
